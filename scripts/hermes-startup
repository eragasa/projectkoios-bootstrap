#!/usr/bin/env bash
# hermes-startup — Hermes startup/resume helper
#
# Usage:
#   ./scripts/hermes-startup [new]
#   ./scripts/hermes-startup --new
#
# Default mode is read-only resume inspection.
# New-session mode writes a durable timestamped session note, then prints the
# same startup surface.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WS="$ROOT/workspaces/hermes"
MODE="inspect"

case "${1:-}" in
  new|--new) MODE="new" ;;
esac

now_utc() {
  date -u +%Y%m%d.%H%M%SZ
}

latest_timestamped_session() {
  if [ ! -d "$WS/sessions" ]; then
    return 0
  fi

  find "$WS/sessions" -maxdepth 1 -type f | \
    awk -F/ '
      {
        name = $NF
        if (name ~ /^[0-9]{8}\.[0-9]{6}Z?-.*\.md$/) print $0
      }
    ' | sort | tail -n 1
}

make_session_note() {
  local note="$WS/sessions/$(now_utc)-hermes-start.md"
  local branch
  branch="$(git -C "$ROOT" branch --show-current 2>/dev/null || true)"
  {
    echo "# Hermes new session"
    echo
    echo "## Snapshot"
    echo "- Repo: projectkoios-bootstrap"
    echo "- Branch: ${branch:-unknown}"
    echo "- Started: $(now_utc)"
    echo "- Source: ./scripts/hermes-startup new"
    echo
    echo "## Read first"
    echo "- workspaces/hermes/state.md"
    echo "- workspaces/hermes/active.md"
    echo "- newest workspaces/hermes/sessions/*.md"
    echo "- workspaces/hermes/inbox/"
    echo "- workspaces/hermes/outbox/"
    echo
    echo "## Session marker"
    echo "new session"
    echo
    echo "## Notes"
    echo "This file is the durable session-start marker for this run."
  } > "$note"
  printf '%s\n' "$note"
}

read_file() {
  local label="$1"
  local path="$2"
  echo "## ${label}"
  if [ -f "$path" ]; then
    cat "$path"
  else
    echo "(missing: $path)"
  fi
  echo
}

if [ "$MODE" = "new" ]; then
  note_path="$(make_session_note)"
  echo "new session"
  echo "session note: ${note_path}"
  echo
fi

printf '# Hermes autoprocess startup\n\n'

read_file "Hermes state" "$WS/state.md"
read_file "Hermes active" "$WS/active.md"

latest_session="$(latest_timestamped_session || true)"
if [ -n "$latest_session" ] && [ -f "$latest_session" ]; then
  read_file "Newest Hermes session" "$latest_session"
else
  echo '## Newest Hermes session'
  echo '(none)'
  echo
fi

printf '## Inbox\n'
find "$WS/inbox" -maxdepth 1 -type f | sort || true
printf '\n'
printf '## Outbox\n'
find "$WS/outbox" -maxdepth 1 -type f | sort || true
printf '\n'

printf '## Repo\n'
(git -C "$ROOT" branch --show-current || true)
(git -C "$ROOT" status --short || true)
printf '\n'

echo '## Recent commits'
git -C "$ROOT" log --oneline -3 || true
printf '\n'
