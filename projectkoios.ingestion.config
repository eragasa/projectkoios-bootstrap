version: 1
project: projectkoios
pipeline:
  mode: derived-index
  answer_format: cited_summary
  retrieval_depth: 1
validation:
  mode: strict
source:
  include:
    - docs/architecture/adr/**/*.md
  exclude: []
ontology:
  document_types:
    - adr
extraction:
  backend:
    name: ollama
    endpoint: http://localhost:11434
    model: llama3.2
    timeout_seconds: 60
    on_failure: error
retrieval:
  max_nodes: 1
evaluation:
  mode: disabled
presets:
  adr:
    source:
      include:
        - docs/architecture/adr/**/*.md
      exclude: []
