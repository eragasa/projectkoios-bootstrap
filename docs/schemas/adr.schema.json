{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectkoios.local/schemas/adr.schema.json",
  "title": "ArchitectureDecisionRecord",
  "description": "Canonical JSON source of truth for Project Koios ADRs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "status",
    "context",
    "decision",
    "consequences",
    "architecture_spec",
    "acceptance_criteria",
    "implementation_brief",
    "resolved_open_questions",
    "non_goals",
    "validation_expectations"
  ],
  "$defs": {
    "Status": {
      "type": "string",
      "enum": [
        "proposal",
        "draft",
        "accepted",
        "active",
        "superseded"
      ]
    },
    "ArchitectureDomain": {
      "type": "string",
      "enum": [
        "systems",
        "hardware",
        "software"
      ]
    },
    "Context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "from",
        "acting_as",
        "scope",
        "repository",
        "delegated_operator",
        "architecture_domain"
      ],
      "properties": {
        "origin": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "acting_as": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "delegated_operator": {
          "type": "string",
          "minLength": 1
        },
        "architecture_domain": {
          "$ref": "#/$defs/ArchitectureDomain"
        }
      }
    },
    "Links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "back_to": {
          "type": "string",
          "minLength": 1
        },
        "supersedes": {
          "type": [
            "string",
            "null"
          ]
        },
        "superseded_by": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "WorkflowBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "current_state": {
          "type": "string",
          "minLength": 1
        },
        "allowed_operators": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "entrance_gate": {
          "type": "string",
          "minLength": 1
        },
        "transition_gate": {
          "type": "string",
          "minLength": 1
        },
        "exit_gate": {
          "type": "string",
          "minLength": 1
        },
        "gating_adr": {
          "type": "string",
          "minLength": 1
        },
        "blocked_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "enabled_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "$ref": "#/$defs/Status"
    },
    "context": {
      "$ref": "#/$defs/Context"
    },
    "decision": {
      "type": "string",
      "minLength": 1
    },
    "consequences": {
      "type": "string",
      "minLength": 1
    },
    "architecture_spec": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "implementation_brief": {
      "type": "string",
      "minLength": 1
    },
    "resolved_open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation_expectations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "links": {
      "$ref": "#/$defs/Links"
    },
    "workflow_binding": {
      "$ref": "#/$defs/WorkflowBinding"
    }
  }
}
