{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectkoios.local/schemas/schema.record-base.json",
  "title": "SchemaRecordBase",
  "description": "Base envelope for schema-backed Project Koios records. Family schemas constrain content.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "content"
  ],
  "$defs": {
    "Timestamp": {
      "type": "string",
      "pattern": "^[0-9]{8}\\.[0-9]{6}(?:Z)?$",
      "description": "Compact timestamp in YYYYMMDD.HHMMSS or YYYYMMDD.HHMMSSZ form."
    },
    "RecordStatus": {
      "type": "string",
      "enum": [
        "proposal",
        "draft",
        "accepted",
        "active",
        "superseded"
      ]
    },
    "Origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "method",
        "actor",
        "authority"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "user_request",
            "role_output",
            "migration",
            "import",
            "derived"
          ]
        },
        "method": {
          "type": "string",
          "enum": [
            "manual",
            "intercom",
            "filesystem",
            "renderer",
            "ingester",
            "script"
          ]
        },
        "actor": {
          "type": "string",
          "enum": [
            "ATHENA",
            "VULCAN",
            "KOIOS",
            "HERMES",
            "user",
            "tool"
          ]
        },
        "authority": {
          "type": "string",
          "enum": [
            "user",
            "role",
            "policy",
            "adr",
            "none"
          ]
        }
      }
    },
    "Domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_type",
        "domain_subtype",
        "domain_scope"
      ],
      "properties": {
        "domain_type": {
          "type": "string",
          "enum": [
            "architecture",
            "implementation",
            "validation",
            "knowledge",
            "workflow",
            "schema",
            "process"
          ]
        },
        "domain_subtype": {
          "type": "string",
          "minLength": 1
        },
        "domain_scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "SourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "relationship"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "relationship": {
          "type": "string",
          "enum": [
            "prompt",
            "review",
            "supersedes",
            "derived_from",
            "migration_source",
            "reference",
            "controls",
            "supports"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "claim"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "commit",
            "file",
            "validation",
            "review",
            "message",
            "artifact"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "projection_type",
        "source_record_id",
        "source_schema_id",
        "source_schema_version",
        "projection_method",
        "generated_by",
        "editable",
        "source_of_truth"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "projection_type": {
          "type": "string",
          "enum": [
            "generated_markdown",
            "editable_markdown",
            "json",
            "index"
          ]
        },
        "source_record_id": {
          "type": "string",
          "minLength": 1
        },
        "source_schema_id": {
          "type": "string",
          "minLength": 1
        },
        "source_schema_version": {
          "type": "string",
          "minLength": 1
        },
        "projection_method": {
          "type": "string",
          "enum": [
            "manual",
            "renderer",
            "ingester",
            "script"
          ]
        },
        "generated_by": {
          "type": "string",
          "minLength": 1
        },
        "generated_on": {
          "$ref": "#/$defs/Timestamp"
        },
        "editable": {
          "type": "boolean"
        },
        "source_of_truth": {
          "type": "string",
          "enum": [
            "schema_record",
            "projection",
            "unknown"
          ]
        }
      }
    },
    "RecordMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "schema_id",
        "schema_version",
        "record_version",
        "title",
        "status",
        "created_on",
        "updated_on",
        "origin",
        "scope",
        "repository",
        "domain",
        "source_artifacts",
        "derived_from",
        "evidence",
        "projections"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "schema_id": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "record_version": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/RecordStatus"
        },
        "created_on": {
          "$ref": "#/$defs/Timestamp"
        },
        "updated_on": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "$ref": "#/$defs/Domain"
        },
        "source_artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceArtifact"
          }
        },
        "derived_from": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceArtifact"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "projections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Projection"
          }
        }
      }
    }
  },
  "properties": {
    "metadata": {
      "$ref": "#/$defs/RecordMetadata"
    },
    "content": {
      "type": "object",
      "description": "Family-specific record content. The base schema intentionally does not constrain internal content fields."
    }
  }
}
